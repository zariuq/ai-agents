  exact andER ({11, 12, 13, 14, 15, 16} c= 17) (forall x :e {11, 12, 13, 14, 15, 16}, forall y :e {11, 12, 13, 14, 15, 16}, x <> y -> ~Adj17 x y) Hindep.
claim H11in: 11 :e {11, 12, 13, 14, 15, 16}.
  exact binunionI1 {11, 12, 13, 14, 15} {16} 11 (binunionI1 {11, 12, 13, 14} {15} 11 (binunionI1 {11, 12, 13} {14} 11 (binunionI1 {11, 12} {13} 11 (UPairI1 11 12)))).
claim H15in: 15 :e {11, 12, 13, 14, 15, 16}.
  exact binunionI1 {11, 12, 13, 14, 15} {16} 15 (binunionI2 {11, 12, 13, 14} {15} 15 (SingI 15)).
claim Hneq: 11 <> 15.
  assume Heq: 11 = 15. apply neq_15_11. symmetry. exact Heq.
claim Hnot: ~Adj17 11 15.
  exact Hind 11 H11in 15 H15in Hneq.
exact Hnot Adj17_11_15.
Qed.

