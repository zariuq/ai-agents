Theorem Adj17_not_indep_0_1_2_3_4_5 : ~is_indep_set 17 Adj17 {0, 1, 2, 3, 4, 5}.
assume Hindep: is_indep_set 17 Adj17 {0, 1, 2, 3, 4, 5}.
prove False.
claim Hind: forall x :e {0, 1, 2, 3, 4, 5}, forall y :e {0, 1, 2, 3, 4, 5}, x <> y -> ~Adj17 x y.
  exact andER ({0, 1, 2, 3, 4, 5} c= 17) (forall x :e {0, 1, 2, 3, 4, 5}, forall y :e {0, 1, 2, 3, 4, 5}, x <> y -> ~Adj17 x y) Hindep.
claim H4in: 4 :e {0, 1, 2, 3, 4, 5}.
  exact binunionI1 {0, 1, 2, 3, 4} {5} 4 (binunionI2 {0, 1, 2, 3} {4} 4 (SingI 4)).
claim H5in: 5 :e {0, 1, 2, 3, 4, 5}.
  exact binunionI2 {0, 1, 2, 3, 4} {5} 5 (SingI 5).
claim Hneq: 4 <> 5.
  assume Heq: 4 = 5. apply neq_5_4. symmetry. exact Heq.
claim Hnot: ~Adj17 4 5.
  exact Hind 4 H4in 5 H5in Hneq.
exact Hnot Adj17_4_5.
Qed.

