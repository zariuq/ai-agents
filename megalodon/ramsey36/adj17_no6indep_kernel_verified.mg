prove False.
claim Hind: forall x :e {3, 7, 11, 13, 15, 16}, forall y :e {3, 7, 11, 13, 15, 16}, x <> y -> ~Adj17 x y.
  exact andER ({3, 7, 11, 13, 15, 16} c= 17) (forall x :e {3, 7, 11, 13, 15, 16}, forall y :e {3, 7, 11, 13, 15, 16}, x <> y -> ~Adj17 x y) Hindep.
claim H3in: 3 :e {3, 7, 11, 13, 15, 16}.
  exact binunionI1 {3, 7, 11, 13, 15} {16} 3 (binunionI1 {3, 7, 11, 13} {15} 3 (binunionI1 {3, 7, 11} {13} 3 (binunionI1 {3, 7} {11} 3 (UPairI1 3 7)))).
claim H13in: 13 :e {3, 7, 11, 13, 15, 16}.
  exact binunionI1 {3, 7, 11, 13, 15} {16} 13 (binunionI1 {3, 7, 11, 13} {15} 13 (binunionI2 {3, 7, 11} {13} 13 (SingI 13))).
claim Hneq: 3 <> 13.
  assume Heq: 3 = 13. apply neq_13_3. symmetry. exact Heq.
claim Hnot: ~Adj17 3 13.
  exact Hind 3 H3in 13 H13in Hneq.
exact Hnot Adj17_3_13.
Qed.

