prove False.
claim Hind: forall x :e {2, 3, 5, 11, 13, 16}, forall y :e {2, 3, 5, 11, 13, 16}, x <> y -> ~Adj17 x y.
  exact andER ({2, 3, 5, 11, 13, 16} c= 17) (forall x :e {2, 3, 5, 11, 13, 16}, forall y :e {2, 3, 5, 11, 13, 16}, x <> y -> ~Adj17 x y) Hindep.
claim H3in: 3 :e {2, 3, 5, 11, 13, 16}.
  exact binunionI1 {2, 3, 5, 11, 13} {16} 3 (binunionI1 {2, 3, 5, 11} {13} 3 (binunionI1 {2, 3, 5} {11} 3 (binunionI1 {2, 3} {5} 3 (UPairI2 2 3)))).
claim H13in: 13 :e {2, 3, 5, 11, 13, 16}.
  exact binunionI1 {2, 3, 5, 11, 13} {16} 13 (binunionI2 {2, 3, 5, 11} {13} 13 (SingI 13)).
claim Hneq: 3 <> 13.
  assume Heq: 3 = 13. apply neq_13_3. symmetry. exact Heq.
claim Hnot: ~Adj17 3 13.
  exact Hind 3 H3in 13 H13in Hneq.
exact Hnot Adj17_3_13.
Qed.

