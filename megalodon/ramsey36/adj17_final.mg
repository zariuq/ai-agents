prove False.
apply andER Hindep.
prove (forall x :e {2, 3, 9, 14, 15, 16}, forall y :e {2, 3, 9, 14, 15, 16}, x <> y -> ~Adj17 x y) -> False.
assume Hind.
apply Hind 2 _ 15 _ _.
- apply binunionI1. apply binunionI1. apply binunionI1. apply binunionI1. exact UPairI1.
- apply binunionI1. apply binunionI2. exact SingI.
- exact neq_2_15.
- assume Hnot: ~Adj17 2 15.
  exact Hnot Adj17_2_15.
Qed.

