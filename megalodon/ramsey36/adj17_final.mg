prove False.
apply andER Hindep.
prove (forall x :e {2, 3, 4, 9, 12, 13}, forall y :e {2, 3, 4, 9, 12, 13}, x <> y -> ~Adj17 x y) -> False.
assume Hind.
apply Hind 2 _ 12 _ _.
- apply binunionI1. apply binunionI1. apply binunionI1. apply binunionI1. exact UPairI1.
- apply binunionI1. apply binunionI2. exact SingI.
- exact neq_2_12.
- assume Hnot: ~Adj17 2 12.
  exact Hnot Adj17_2_12.
Qed.

