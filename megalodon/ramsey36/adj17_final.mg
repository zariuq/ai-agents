prove False.
apply andER Hindep.
prove (forall x :e {1, 5, 8, 11, 15, 16}, forall y :e {1, 5, 8, 11, 15, 16}, x <> y -> ~Adj17 x y) -> False.
assume Hind.
apply Hind 1 _ 11 _ _.
- apply binunionI1. apply binunionI1. apply binunionI1. apply binunionI1. exact UPairI1.
- apply binunionI1. apply binunionI1. apply binunionI2. exact SingI.
- exact neq_1_11.
- assume Hnot: ~Adj17 1 11.
  exact Hnot Adj17_1_11.
Qed.

