prove False.
apply andER Hindep.
prove (forall x :e {0, 3, 8, 9, 12, 16}, forall y :e {0, 3, 8, 9, 12, 16}, x <> y -> ~Adj17 x y) -> False.
assume Hind.
apply Hind 0 _ 9 _ _.
- apply binunionI1. apply binunionI1. apply binunionI1. apply binunionI1. exact UPairI1.
- apply binunionI1. apply binunionI1. apply binunionI2. exact SingI.
- exact neq_0_9.
- assume Hnot: ~Adj17 0 9.
  exact Hnot Adj17_0_9.
Qed.

