prove False.
apply andER Hindep.
prove (forall x :e {2, 4, 5, 8, 15, 16}, forall y :e {2, 4, 5, 8, 15, 16}, x <> y -> ~Adj17 x y) -> False.
assume Hind: forall x :e {2, 4, 5, 8, 15, 16}, forall y :e {2, 4, 5, 8, 15, 16}, x <> y -> ~Adj17 x y.
apply Hind 2 _ 8 _ _.
- apply binunionI1. apply binunionI1. apply binunionI1. apply binunionI1. exact UPairI1.
- apply binunionI1. apply binunionI1. apply binunionI2. exact SingI.
- assume Heq: 2 = 8. apply neq_8_2. symmetry. exact Heq.
- assume Hnot: ~Adj17 2 8.
  exact Hnot Adj17_2_8.
Qed.

