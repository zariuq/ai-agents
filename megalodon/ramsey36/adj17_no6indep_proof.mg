prove False.
apply andER Hindep.
prove (forall x :e {0, 2, 4, 8, 13, 16}, forall y :e {0, 2, 4, 8, 13, 16}, x <> y -> ~Adj17 x y) -> False.
assume Hind: forall x :e {0, 2, 4, 8, 13, 16}, forall y :e {0, 2, 4, 8, 13, 16}, x <> y -> ~Adj17 x y.
apply Hind 0 _ 16 _ _.
- apply binunionI1. apply binunionI1. apply binunionI1. apply binunionI1. exact UPairI1.
- apply binunionI2. exact SingI.
- assume Heq: 0 = 16. apply neq_16_0. symmetry. exact Heq.
- assume Hnot: ~Adj17 0 16.
  exact Hnot Adj17_0_16.
Qed.

