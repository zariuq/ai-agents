prove False.
apply andER Hindep.
prove (forall x :e {6, 7, 12, 13, 14, 15}, forall y :e {6, 7, 12, 13, 14, 15}, x <> y -> ~Adj17 x y) -> False.
assume Hind: forall x :e {6, 7, 12, 13, 14, 15}, forall y :e {6, 7, 12, 13, 14, 15}, x <> y -> ~Adj17 x y.
apply Hind 6 _ 12 _ _.
- apply binunionI1. apply binunionI1. apply binunionI1. apply binunionI1. exact UPairI1.
- apply binunionI1. apply binunionI1. apply binunionI1. apply binunionI2. exact SingI.
- assume Heq: 6 = 12. apply neq_12_6. symmetry. exact Heq.
- assume Hnot: ~Adj17 6 12.
  exact Hnot Adj17_6_12.
Qed.

