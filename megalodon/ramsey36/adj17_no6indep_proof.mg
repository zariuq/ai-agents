prove False.
apply andER Hindep.
prove (forall x :e {0, 3, 5, 8, 12, 15}, forall y :e {0, 3, 5, 8, 12, 15}, x <> y -> ~Adj17 x y) -> False.
assume Hind: forall x :e {0, 3, 5, 8, 12, 15}, forall y :e {0, 3, 5, 8, 12, 15}, x <> y -> ~Adj17 x y.
apply Hind 0 _ 15 _ _.
- apply binunionI1. apply binunionI1. apply binunionI1. apply binunionI1. exact UPairI1.
- apply binunionI2. exact SingI.
- assume Heq: 0 = 15. apply neq_15_0. symmetry. exact Heq.
- assume Hnot: ~Adj17 0 15.
  exact Hnot Adj17_0_15.
Qed.

