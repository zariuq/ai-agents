prove False.
apply andER Hindep.
prove (forall x :e {0, 4, 6, 7, 13, 14}, forall y :e {0, 4, 6, 7, 13, 14}, x <> y -> ~Adj17 x y) -> False.
assume Hind: forall x :e {0, 4, 6, 7, 13, 14}, forall y :e {0, 4, 6, 7, 13, 14}, x <> y -> ~Adj17 x y.
apply Hind 0 _ 14 _ _.
- apply binunionI1. apply binunionI1. apply binunionI1. apply binunionI1. exact UPairI1.
- apply binunionI2. exact SingI.
- assume Heq: 0 = 14. apply neq_14_0. symmetry. exact Heq.
- assume Hnot: ~Adj17 0 14.
  exact Hnot Adj17_0_14.
Qed.

