prove False.
apply andER Hindep.
prove (forall x :e {3, 7, 10, 12, 13, 14}, forall y :e {3, 7, 10, 12, 13, 14}, x <> y -> ~Adj17 x y) -> False.
assume Hind: forall x :e {3, 7, 10, 12, 13, 14}, forall y :e {3, 7, 10, 12, 13, 14}, x <> y -> ~Adj17 x y.
apply Hind 3 _ 13 _ _.
- apply binunionI1. apply binunionI1. apply binunionI1. apply binunionI1. exact UPairI1.
- apply binunionI1. apply binunionI2. exact SingI.
- assume Heq: 3 = 13. apply neq_13_3. symmetry. exact Heq.
- assume Hnot: ~Adj17 3 13.
  exact Hnot Adj17_3_13.
Qed.

