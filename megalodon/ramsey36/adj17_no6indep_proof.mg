prove False.
apply andER Hindep.
prove (forall x :e {6, 9, 10, 11, 12, 13}, forall y :e {6, 9, 10, 11, 12, 13}, x <> y -> ~Adj17 x y) -> False.
assume Hind: forall x :e {6, 9, 10, 11, 12, 13}, forall y :e {6, 9, 10, 11, 12, 13}, x <> y -> ~Adj17 x y.
apply Hind 6 _ 10 _ _.
- apply binunionI1. apply binunionI1. apply binunionI1. apply binunionI1. exact UPairI1.
- apply binunionI1. apply binunionI1. apply binunionI1. apply binunionI2. exact SingI.
- assume Heq: 6 = 10. apply neq_10_6. symmetry. exact Heq.
- assume Hnot: ~Adj17 6 10.
  exact Hnot Adj17_6_10.
Qed.

