Definition is_indep_set : set -> (set -> set -> prop) -> set -> prop :=
  fun V R S => S c= V /\ (forall x :e S, forall y :e S, x <> y -> ~R x y).

Definition no_k_indep : set -> (set -> set -> prop) -> set -> prop :=
  fun V R k => forall S, S c= V -> equip k S -> ~is_indep_set V R S.

Theorem Adj17_not_indep_0_1_2_3_4_5 : ~is_indep_set 17 Adj17 {0, 1, 2, 3, 4, 5}.
assume Hindep: is_indep_set 17 Adj17 {0, 1, 2, 3, 4, 5}.
prove False.
apply andER Hindep.
prove (forall x :e {0, 1, 2, 3, 4, 5}, forall y :e {0, 1, 2, 3, 4, 5}, x <> y -> ~Adj17 x y) -> False.
assume Hind: forall x :e {0, 1, 2, 3, 4, 5}, forall y :e {0, 1, 2, 3, 4, 5}, x <> y -> ~Adj17 x y.
apply Hind 4 _ 5 _ _.
- apply binunionI1. apply binunionI2. exact SingI.
- apply binunionI2. exact SingI.
- assume Heq: 4 = 5. apply neq_5_4. symmetry. exact Heq.
- assume Hnot: ~Adj17 4 5.
  exact Hnot Adj17_4_5.
Qed.

