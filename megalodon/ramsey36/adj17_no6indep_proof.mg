  p {10, 11, 13, 14, 15, 16} ->
  p {10, 12, 13, 14, 15, 16} ->
  p {11, 12, 13, 14, 15, 16} ->
  forall S, S c= 17 -> equip 6 S -> p S.

Theorem Adj17_no_6_indep : no_k_indep 17 Adj17 6.
prove forall S, S c= 17 -> equip 6 S -> ~is_indep_set 17 Adj17 S.
assume S. assume HS17: S c= 17. assume H6: equip 6 S.
apply subsets_6_17_cases (fun S => ~is_indep_set 17 Adj17 S) _ _ _ HS17 H6.
